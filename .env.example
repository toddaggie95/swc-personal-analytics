# Place only the regenerated secret here after activation. Never reuse the exposed secret.
SWC_CLIENT_ID=
SWC_CLIENT_SECRET=
# Live commands require both to be true. Leave false while awaiting SWC.
SWC_APP_ACTIVATED=false
SWC_SECRET_REGENERATED=false
# state-required is fail-closed until SWC's actual OOB result is verified.
# code-only permits manual code entry without claiming returned-state validation.
SWC_OOB_RESULT_MODE=state-required
# disabled or s256; enable only after SWC confirms Installed/OOB compatibility.
SWC_PKCE=disabled
# Optional absolute path OUTSIDE this repository and cloud-sync directories.
# Defaults to LOCALAPPDATA/SWC Personal Analytics on Windows, ~/.local/share/... otherwise.
SWC_PRIVATE_DIR=
