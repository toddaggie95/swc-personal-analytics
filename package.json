{
  "name": "swc-personal-analytics",
  "version": "0.1.0",
  "description": "Read-only SWC OAuth and station inventory proof of concept",
  "main": "dist/cli/index.js",
  "scripts": {
    "cli": "tsx src/cli/index.ts",
    "status": "tsx src/cli/index.ts status",
    "auth:start": "tsx src/cli/index.ts auth:start",
    "auth:finish": "tsx src/cli/index.ts auth:finish",
    "sync:stations": "tsx src/cli/index.ts sync:stations",
    "sync:ships": "tsx src/cli/index.ts sync:ships",
    "sync:faction-materials": "tsx src/cli/index.ts sync:faction-materials",
    "sync:faction-materials:tff": "tsx src/cli/index.ts sync:faction-materials:tff",
    "sync:faction-materials:tjo": "tsx src/cli/index.ts sync:faction-materials:tjo",
    "sync:faction-stations": "tsx src/cli/index.ts sync:faction-stations",
    "sync:faction-stations:tff": "tsx src/cli/index.ts sync:faction-stations:tff",
    "sync:faction-stations:tjo": "tsx src/cli/index.ts sync:faction-stations:tjo",
    "sync:faction-facilities": "tsx src/cli/index.ts sync:faction-facilities",
    "sync:faction-facilities:tff": "tsx src/cli/index.ts sync:faction-facilities:tff",
    "sync:faction-facilities:tjo": "tsx src/cli/index.ts sync:faction-facilities:tjo",
    "typecheck": "tsc -p tsconfig.check.json",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.3",
    "swcombine-sdk": "3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=18.18.0"
  }
}
